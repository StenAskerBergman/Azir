@COUNCIL_HEADER_X = 16
@COUNCIL_STATUS_X = 16
@COUNCIL_HEADER_Y = 67
@COUNCIL_STATUS_Y = 52

guiTypes = {
    containerWindowType = {
        name = "plt_council_decision_ui_window"
        position = { x = 0 y = 0 }
        size = { width = 100% height = 92 }

        iconType = {
            name = "council_icon"
            spriteType = "GFX_decision_category_usa_congress_senate_ui"
            position = { x = 335 y = 2 }
            scale = 1.800292
        }

        instantTextBoxType = {
            name = "council_support_header"
            position = { x = @COUNCIL_HEADER_X y = @COUNCIL_HEADER_Y }
            font = "hoi_24header"
            text = "PLT_council_support_header"
            format = center
            fixedsize = yes
            maxWidth = 280
            maxHeight = 24
        }

        instantTextBoxType = {
            name = "council_support_amount"
            position = { x = @COUNCIL_STATUS_X y = @COUNCIL_STATUS_Y }
            font = "hoi_18mbs"
            text = "PLT_council_support_amount"
            format = center
            fixedsize = yes
            maxWidth = 280
        }
    }
}
